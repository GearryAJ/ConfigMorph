set network virtual-router default routing-table ip static-route route_1 destination 0.0.0.0/0
set network virtual-router default routing-table ip static-route route_1 nexthop ip-address 192.0.2.1
set network virtual-router default routing-table ip static-route route_1 interface ethernet1/1
set network virtual-router default routing-table ip static-route route_1 metric 0
